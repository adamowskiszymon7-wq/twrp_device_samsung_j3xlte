# Unified & Corected fstab v2 for OrangeFox Recovery Project

# mount point   fstype    device                                                 flags
/boot           emmc      /dev/block/platform/sdio_emmc/by-name/KERNEL           flags=display="Boot";backup=1
/recovery       emmc      /dev/block/platform/sdio_emmc/by-name/RECOVERY         flags=display="Recovery";backup=1
/system         ext4      /dev/block/platform/sdio_emmc/by-name/SYSTEM           flags=display="System";backup=1;wipeingui
/data           ext4      /dev/block/platform/sdio_emmc/by-name/userdata         flags=length=-16384;encryptable=footer
/cache          ext4      /dev/block/platform/sdio_emmc/by-name/CACHE            flags=display="Cache";wipeingui

# Extra partitions
/efs            ext4      /dev/block/platform/sdio_emmc/by-name/efs              flags=display="EFS";backup=1
/preload        ext4      /dev/block/platform/sdio_emmc/by-name/HIDDEN           flags=display="Preload";wipeingui;backup=1
/productinfo    ext4      /dev/block/platform/sdio_emmc/by-name/prodnv           flags=display="Product Info";backup=1
/persdata       ext4      /dev/block/platform/sdio_emmc/by-name/PERSDATA         flags=display="Persdata";backup=1

# Modem & Baseband partitions
/l_modem        emmc      /dev/block/platform/sdio_emmc/by-name/l_modem          flags=display="Modem";backup=1
/l_ldsp         emmc      /dev/block/platform/sdio_emmc/by-name/l_ldsp           flags=display="L_LDSP";subpartitionof=/l_modem;backup=1
/l_gdsp         emmc      /dev/block/platform/sdio_emmc/by-name/l_gdsp           flags=display="L_GDSP";subpartitionof=/l_modem;backup=1
/nvitem         emmc      /dev/block/platform/sdio_emmc/by-name/l_fixnv2         flags=display="NV Item";backup=1
/pmsys          emmc      /dev/block/platform/sdio_emmc/by-name/pm_sys           flags=display="PM Sys";backup=1
/l_warm         emmc      /dev/block/platform/sdio_emmc/by-name/l_warm           flags=display="L_Warm";backup=1

# Removable storage
/external_sd    vfat      /dev/block/mmcblk1p1                                   flags=display="Micro SDcard";storage;wipeingui;removable
/usb-otg        vfat      /dev/block/sda1         /dev/block/sda                 flags=display="USB-OTG";storage;wipeingui;removable






